# Copy to .env and fill in. Never commit .env.

# Required: your ntfy topic. Topics on ntfy.sh are public, so use a long,
# hard-to-guess name, e.g. mvt-pokemon-7f3k9q2xw8. Reusing your Innova
# watcher's topic is fine; the titles say "MVT".
NTFY_TOPIC=

# What to watch (defaults shown). Comma-separated. Each term is searched on the
# store, and a product matches when every word of the term is in its name.
WATCH_TERMS=30th celebration,delta reign
# Products whose names contain any of these are ignored. Set to "none" to disable.
# EXCLUDE=japanese,japansese,chinese,korean,simplified,traditional,thai,indonesian,german,french,spanish,italian,ultra pro,dragon shield,binder,portfolio,sleeves,deck box,playmat,protector,protective case,event
# Push a heads-up when a new matching product is listed but not buyable yet.
ALERT_NEW_LISTINGS=true

# Optional (defaults shown)
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # access token, only needed for a protected/self-hosted ntfy
POLL_INTERVAL_SECONDS=180
JITTER_PERCENT=20
CONFIRMATIONS=2
HEARTBEAT_TIME=09:00
TIMEZONE=America/New_York
# STATE_FILE=./state.json   # leave unset for systemd/Docker; they set their own path
LOG_LEVEL=INFO

# Advanced (defaults shown)
# REMINDER_INTERVAL_SECONDS=900   # while still in stock, remind every 15 min...
# MAX_REMINDERS=3                 # ...up to this many times per product (0 disables reminders)
# FAILURE_ALERT_AFTER_SECONDS=1800
# API_BASE=https://cdn5.editmysite.com/app/store/api/v28/editor/users/132547976/sites/272811402825390393
